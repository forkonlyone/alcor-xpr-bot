# ============================================================
# Alcor XPR Arbitrage Bot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Your Proton account name (e.g., "myaccount")
PROTON_USERNAME=

# Your Proton private key (active permission)
# NEVER share this key or commit it to git!
PROTON_PRIVATE_KEY=

# ============================================================
# Trading Configuration
# ============================================================

# Amount of XPR to use per trade (default: 100)
TRADE_AMOUNT_XPR=100

# Minimum profit percentage to execute a trade (default: 0.5 = 0.5%)
MIN_PROFIT_PERCENT=0.5

# Maximum slippage tolerance percentage (default: 1.0 = 1%)
MAX_SLIPPAGE_PERCENT=1.0

# Minimum pool TVL in USD to consider (default: 100)
MIN_POOL_TVL_USD=100

# Scan interval in milliseconds (default: 5000 = 5 seconds)
SCAN_INTERVAL_MS=5000

# Enable dry run mode (true = simulate only, false = execute trades)
DRY_RUN=true

# Maximum concurrent route calculations (default: 10)
MAX_CONCURRENT_ROUTES=10

# ============================================================
# Advanced Configuration
# ============================================================

# Proton RPC endpoints (comma-separated for failover)
PROTON_RPC_ENDPOINTS=https://proton.eosusa.io,https://api.protonnz.com,https://proton.cryptolions.io

# Alcor API base URL
ALCOR_API_URL=https://proton.alcor.exchange/api/v2

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Maximum number of hops for multi-hop routes (2 = direct, 3 = triangular)
MAX_ROUTE_HOPS=3
